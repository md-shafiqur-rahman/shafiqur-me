{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/index.html#/collections/post",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html#/collections/post",
      "permanent": false
    }
  ]
}
