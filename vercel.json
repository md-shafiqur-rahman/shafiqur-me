{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/index.html#/collections/post",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html#/collections/post",
      "permanent": false
    },
    {
      "source": "/profile.png",
      "destination": "/images/md-shafiqur-rahman-n8n-ai-automation-expert.jpg",
      "permanent": true
    },
    {
      "source": "/logo-shafiqur.png",
      "destination": "/images/shafiqur-avatar.png",
      "permanent": true
    }
  ]
}
